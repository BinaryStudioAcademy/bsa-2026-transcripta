{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/overlay/**",
              "components/verification/**",
              "ui_kits/app/**",
              "ui_kits/landing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Fraunces|Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Fraunces, Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='BudgetMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:spent|limit|onRaise|key|ref|className|style|children)$/]",
        "message": "<BudgetMeter> doesn't accept that prop. Declared props: spent, limit, onRaise."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|destructive)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|landing)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg' | 'landing'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|disabled|onChange|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, disabled, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|mono|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: tone, mono, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:seal|ok|warn|danger)$/]",
        "message": "<Chip> tone must be one of 'seal' | 'ok' | 'warn' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContextMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:tip|children|key|ref|className|style|children)$/]",
        "message": "<ContextMark> doesn't accept that prop. Declared props: tip, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|inline|onClose|actions|children|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, inline, onClose, actions, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dropzone'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|file|reason|onChoose|key|ref|className|style|children)$/]",
        "message": "<Dropzone> doesn't accept that prop. Declared props: state, file, reason, onChoose."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dropzone'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:rest|over|selected|rejected)$/]",
        "message": "<Dropzone> state must be one of 'rest' | 'over' | 'selected' | 'rejected'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|id|placeholder|disabled|type|value|onChange|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, id, placeholder, disabled, type, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kbd'] > JSXAttribute > JSXIdentifier[name!=/^(?:down|children|key|ref|className|style|children)$/]",
        "message": "<Kbd> doesn't accept that prop. Declared props: down, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:pages|onSelect|onPrev|onNext|thumbs|legend|key|ref|className|style|children)$/]",
        "message": "<PageStrip> doesn't accept that prop. Declared props: pages, onSelect, onPrev, onNext, thumbs, legend."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|left|right|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, left, right."
      },
      {
        "selector": "JSXOpeningElement[name.name='QueuedChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|key|ref|className|style|children)$/]",
        "message": "<QueuedChip> doesn't accept that prop. Declared props: count."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|name|checked|disabled|onChange|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: label, name, checked, disabled, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|id|options|value|disabled|onChange|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, id, options, value, disabled, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='SplitPane'] > JSXAttribute > JSXIdentifier[name!=/^(?:left|right|storageKey|defaultPct|minPct|maxPct|key|ref|className|style|children)$/]",
        "message": "<SplitPane> doesn't accept that prop. Declared props: left, right, storageKey, defaultPct, minPct, maxPct."
      },
      {
        "selector": "JSXOpeningElement[name.name='StateCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:headline|reason|estimate|actions|key|ref|className|style|children)$/]",
        "message": "<StateCard> doesn't accept that prop. Declared props: headline, reason, estimate, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='Table'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|key|ref|className|style|children)$/]",
        "message": "<Table> doesn't accept that prop. Declared props: columns, rows."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|active|onChange|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: tabs, active, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|id|placeholder|rows|disabled|value|onChange|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: label, id, placeholder, rows, disabled, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|detail|action|onAction|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: tone, title, detail, action, onAction."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|ok|warn|danger)$/]",
        "message": "<Toast> tone must be one of 'neutral' | 'ok' | 'warn' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:tip|open|children|key|ref|className|style|children)$/]",
        "message": "<Tooltip> doesn't accept that prop. Declared props: tip, open, children."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
